# Copy to .env.local and fill in. .env.local is git-ignored and must never be committed.

# --- Admin database (PostgreSQL) ---------------------------------------------
# Database "AmericanLyetuff" on your PostgreSQL server. If you have more than one
# PostgreSQL installed, `npm run db:setup` finds the right port and fixes it here.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/AmericanLyetuff

# Signs admin session cookies. `npm run db:setup` generates one if it is missing.
# Changing it signs everybody out.
ADMIN_SESSION_SECRET=

# --- Email for form notifications (optional until you want emails) -----------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@alsswabi.edu.pk
SMTP_PASS=change-me
SMTP_FROM="American Lycetuff Website <no-reply@alsswabi.edu.pk>"

# Public address of the site, used for links inside notification emails.
SITE_URL=http://localhost:3002

# --- Uploads (Admin -> Media library) -----------------------------------------
# Folder OUTSIDE the project where uploaded images and PDFs are stored.
# Default if unset: a folder named "AmericanLycetuff-media" next to the project.
# MEDIA_DIR=C:/Users/99TECH/AmericanLycetuff-media
